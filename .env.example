# Скопируй этот файл в .env и заполни значения:
#   cp .env.example .env

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456789:AAHdqTcvCH1vGWJxfSeofSAs0K5PALDsaw

# Твой личный numeric telegram id (обязательно).
# Узнать: напиши @userinfobot — он пришлёт "Id: 123456789".
# На этот аккаунт приходят заявки на оплату и работает админка.
ADMIN_ID=123456789

# Таймзона для ежедневной проверки подписок (IANA-формат).
TZ_NAME=Europe/Moscow

# Во сколько проверять подписки и рассылать напоминания.
REMIND_HOUR=12
REMIND_MINUTE=0

# Путь к файлу базы данных.
DB_FILE=./data/bot.db
